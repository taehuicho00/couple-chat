rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // 방 ID = 비밀번호의 SHA-256 해시(64자). 비밀번호를 모르면 방 주소를 알 수 없다.
    function validRoom(roomId) { return roomId.size() == 64; }

    match /rooms/{roomId}/messages/{msgId} {
      allow read: if signedIn() && validRoom(roomId);
      // 새 메시지: 본인 uid로만, 글자는 4000자 이하, 종류는 글자/스티커/사진만
      allow create: if signedIn() && validRoom(roomId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000
        && request.resource.data.get('kind', 'text') in ['text', 'sticker', 'image'];
      // 수정: 번역 결과(tr, src)만 추가 가능. 원문은 못 바꿈
      allow update: if signedIn() && validRoom(roomId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tr', 'src']);
      allow delete: if false;
    }

    // 사진: 휴대폰에서 압축한 JPEG(data URL)를 문서 하나에 저장
    match /rooms/{roomId}/images/{imageId} {
      allow read: if signedIn() && validRoom(roomId);
      allow create: if signedIn() && validRoom(roomId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000
        && request.resource.data.data.matches('data:image/jpeg;base64,.*');
      allow update, delete: if false;
    }

    match /rooms/{roomId}/members/{uid} {
      allow read: if signedIn() && validRoom(roomId);
      allow write: if signedIn() && validRoom(roomId) && uid == request.auth.uid;
    }
  }
}
